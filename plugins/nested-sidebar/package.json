{
  "name": "bb-plugin-nested-sidebar",
  "version": "0.7.1",
  "description": "A group-first sidebar: project groups, worktree-aware thread trees, and activity that bubbles up.",
  "license": "MIT",
  "author": "euanguo (fork of an unpublished Nest fork by verger, itself a fork of Dockside by Mateo Cerquetella)",
  "private": true,
  "keywords": [
    "bb",
    "bb-plugin",
    "sidebar",
    "nest",
    "projects",
    "threads",
    "snooze"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.6",
    "bb": ">=0.36",
    "bbPluginSdk": ">=0.6.141"
  },
  "bb": {
    "name": "Nest",
    "description": "A group-first sidebar: project groups, worktree-aware thread trees, and activity that bubbles up.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@get-bb/plugin-sdk": "0.6.141",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^7.0.0"
  },
  "scripts": {
    "dev": "bb plugin dev .",
    "build": "bb plugin build .",
    "check": "npm run typecheck && npm run typecheck:strict && npm run lint && npm test && npm run build",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit -p tsconfig.source-strict.json",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "clean": "rm -rf dist"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/euanguo/euanguo-plugins.git",
    "directory": "plugins/nested-sidebar"
  },
  "homepage": "https://github.com/euanguo/euanguo-plugins/tree/main/plugins/nested-sidebar#readme",
  "bugs": {
    "url": "https://github.com/euanguo/euanguo-plugins/issues"
  }
}
